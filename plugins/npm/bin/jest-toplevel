#!/usr/bin/env zsh

run-in-terminal-split() {
  python3.12 -c '
import iterm2
import shlex
import sys

async def run_in_split_pane(c: "iterm2.Connection"):
    a = await iterm2.async_get_app(c)
    n = await get_jest_session(a)
    if n is None:
        w = a.current_terminal_window
        t = a.get_tab_by_id(w.selected_tab_id)
        s = a.get_session_by_id(t.active_session_id)
        n = await s.async_split_pane(vertical=True, before=False, profile=None)
        await n.async_set_variable("user.jest-toplevel-split-pane", True)
    await n.async_send_text(" ".join(shlex.quote(r) for r in sys.argv[1:]) + "\n")

async def get_jest_session(a: "iterm2.App"):
    for w in a.terminal_windows:
        for t in w.tabs:
            for s in t.sessions:
                is_jest_session = await s.async_get_variable("user.jest-toplevel-split-pane")
                if is_jest_session:
                    return s

iterm2.run_until_complete(run_in_split_pane)
' $@
}

jest-toplevel() {
  if [[ $1 == --in-terminal-split ]]; then
    shift
    run-in-terminal-split jest-toplevel "$@"
    return
  fi
  local gitPrefix="$(git rev-parse --show-prefix)"
  local noTestPatterns=true
  local dashArg=false
  local jestArgs=()
  local RESOLVED
  for arg in $@; do
    if [[ $arg != -* ]]; then
      if $dashArg; then
        jestArgs+=($arg)
        dashArg=false
      else
        resolve_path $gitPrefix $arg
        jestArgs+=($RESOLVED)
      fi
      noTestPatterns=false
    else
      jestArgs+=($arg)
      if [[
        $arg != (-h|-b|-e|-o|-f|-i|-u) &&
        $arg != (--(no-|)(help|version|all|automock|bail|cache|changedFilesWithAncestor|ci|clearCache|clearMocks|collectCoverage|color(s|))) &&
        $arg != (--(no-|)(coverage|detectLeaks|detectOpenHandles|errorOnDeprecated|expand|findRelatedTests|forceExit|lastCommit|listTests)) &&
        $arg != (--(no-|)(logHeapUsage|noStackTrace|notify|onlyChanged|onlyFailures|passWithNoTests|resetMocks|resetModules|restoreMocks)) &&
        $arg != (--(no-|)(runInBand|showConfig|silent|skipFilter|testLocationInResults|updateSnapshot|useStderr|verbose|watch|watchAll|watchman))
      ]]; then
        dashArg=true
      fi
    fi
  done
  local testPathPattern=()
  $noTestPatterns && jestArgs=($gitPrefix $jestArgs)
  local cdup="$(git rev-parse --show-cdup)"
  local toplevelConfig="${cdup}jest.config.js"
  for ext in ts mjs cjs json; do
    if [[ -e "${cdup}jest.config.$ext" ]]; then
      toplevelConfig="${cdup}jest.config.$ext"
      break
    fi
  done
  if [[ -z $cdup ]]; then
    echo node node_modules/.bin/jest "${jestArgs[@]}";
    node node_modules/.bin/jest "${jestArgs[@]}";
  else
    echo npx --prefix=$PWD jest --config "$toplevelConfig" "${jestArgs[@]}"
    npx --prefix=$PWD jest --config "$toplevelConfig" "${jestArgs[@]}"
  fi
}

resolve_path() {
  setopt extendedglob

  local prefix=$1
  local target=$2
  local MATCH
  while true; do
    MATCH=
    target=${target#(#m)./}
    if [[ -n "$MATCH" ]]; then continue; fi;
    MATCH=
    target=${target#(#m)../}
    if [[ -z "$MATCH" ]]; then break; fi;
    prefix=${prefix:h}/
  done

  RESOLVED=$prefix$target
}

if [[ $ZSH_EVAL_CONTEXT == toplevel ]]; then
  ${0:t} "$@"
fi
