    '--in-memory[only attempt an in-memory rebase]' \
    '--on-disk[skip in-memory rebase and try on-disk directly]' \
    '--no-deduplicate-commits[skip deduplication of identical commits]' \
    '(-m --merge)'{-m,--merge}'[attempt to resolve merge conflicts]' \
    '--reparent[keep descendant contents the same (reparent them)]' \
    '--debug-dump-rebase-constraints[print rebase constraints before executing]' \
    '--debug-dump-rebase-plan[print rebase plan before executing]' \
    '--untracked=[how to handle untracked files]:STRATEGY:(add disable prompt skip)' \
