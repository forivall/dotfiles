#compdef git-branchless
#description Branchless workflow for Git

_git-branchless() {
  local curcontext="$curcontext" state state_descr line ret=1
  typeset -A opt_args

  _arguments -C \
    '-C+[change to directory before running]: :_directories' \
    '--color=[force color output]:COLOR:(auto always never)' \
    '(- :)'{-h,--help}'[print help]' \
    '(- :)'{-V,--version}'[print version]' \
    '(-): :->command' \
    '(-)*:: :->option-or-argument' && ret=0

  case $state in
    (command)
      local -a commands
      commands=(
        'amend:amend the current HEAD commit'
        'bug-report:gather information for a bug report'
        'difftool:use partial commit selector as a Git difftool'
        'gc:run internal garbage collection'
        'hide:hide commits from the smartlog'
        'init:initialize the branchless workflow'
        'install-man-pages:install man-pages to a path'
        'move:move a subtree of commits'
        'next:move to a later commit in the stack'
        'prev:move to an earlier commit in the stack'
        'query:query the commit graph with revsets'
        'repair:restore internal invariants'
        'restack:fix up commits abandoned by a rewrite'
        'record:create a commit by interactively selecting changes'
        'reword:reword commits'
        'smartlog:show the smartlog'
        'split:split commits'
        'submit:push commits to a remote'
        'switch:switch to a branch or commit'
        'sync:move local stacks onto the main branch'
        'test:run a command on each commit in a set'
        'undo:browse or return to a previous state'
        'unhide:unhide previously-hidden commits'
        'wrap:wrap a Git command in a branchless transaction'
        'help:print help'
      )
      _describe -t commands 'git-branchless command' commands && ret=0
      ;;
    (option-or-argument)
      curcontext="${curcontext%:*}:git-branchless-$line[1]:"
      case $line[1] in
        (amend)            _git-branchless-amend ;;
        (bug-report)       _git-branchless-bug-report ;;
        (difftool)         _git-branchless-difftool ;;
        (gc)               _git-branchless-gc ;;
        (hide)             _git-branchless-hide ;;
        (init)             _git-branchless-init ;;
        (install-man-pages) _git-branchless-install-man-pages ;;
        (move)             _git-branchless-move ;;
        (next)             _git-branchless-next ;;
        (prev)             _git-branchless-prev ;;
        (query)            _git-branchless-query ;;
        (repair)           _git-branchless-repair ;;
        (restack)          _git-branchless-restack ;;
        (record)           _git-branchless-record ;;
        (reword)           _git-branchless-reword ;;
        (smartlog)         _git-branchless-smartlog ;;
        (split)            _git-branchless-split ;;
        (submit)           _git-branchless-submit ;;
        (switch)           _git-branchless-switch ;;
        (sync)             _git-branchless-sync ;;
        (test)             _git-branchless-test ;;
        (undo)             _git-branchless-undo ;;
        (unhide)           _git-branchless-unhide ;;
        (wrap)             _git-branchless-wrap ;;
        (help)             _message 'subcommand' ;;
      esac
      ;;
  esac

  return ret
}

# Shared option groups (appended by subcommands)

_git-branchless-amend() {
