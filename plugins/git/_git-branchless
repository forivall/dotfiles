_git-branchless-test() {
  local curcontext="$curcontext" state state_descr line ret=1
  typeset -A opt_args

  _arguments -C \
    '-C+[change to directory]: :_directories' \
    '--color=[force color output]:COLOR:(auto always never)' \
    '(- :)'{-h,--help}'[print help]' \
    '(-): :->command' \
    '(-)*:: :->option-or-argument' && ret=0

  case $state in
    (command)
      local -a commands
      commands=(
        'clean:clean cached test results'
        'run:run a command on a set of commits'
        'show:show results of previous test runs'
        'fix:rewrite commits by running a command on each'
        'help:print help'
      )
      _describe -t commands 'git-branchless test command' commands && ret=0
      ;;
    (option-or-argument)
      curcontext="${curcontext%:*}:git-branchless-test-$line[1]:"
      case $line[1] in
        (clean) _git-branchless-test-clean ;;
        (run)   _git-branchless-test-run ;;
        (show)  _git-branchless-test-show ;;
        (fix)   _git-branchless-test-fix ;;
        (help)  _message 'subcommand' ;;
      esac
      ;;
  esac

  return ret
}

