#!/usr/bin/env zsh

set -euo pipefail

__plugin_dirname=${0:a:h:h}

autoload colors && colors

OPTS_SPEC="\
git checkout-branch [<options>] <args>...
--
h,help    show the help
s,search  search mode
a,all     all branches
r,remote? remote
p,prefix  filter by current '+' prefix
f,force   use --force when checking out
d,detach  use --detach when checking out
t,track?direct|inherit setup upstream when creating a new branch
contains? filter branches containing HEAD or commit
no-track  do not setup upstream when creating a new branch
B         reset branch when initializing a new branch
"
eval "$(echo "$OPTS_SPEC" | git rev-parse --parseopt --stuck-long -- "$@" || echo exit $?)"

term_menu_options=()
all=false
remotes=false
noremote=false
remote_option=
checkout_options=()
pattern=
reset_branch=false
contains=

index=0
for arg in $@; do
  index=$((index+1))
  case "$arg" in
    --search) term_menu_options+=(--search-key none) ;;
    --all) all=true; remotes=true ;;
    --remote=*) remote_option="${arg#--remote=}" ;&
    --remote) remotes=true ;;
    --no-remote) noremote=false ;;
    --prefix)
      branch_name=$(git rev-parse --symbolic-full-name HEAD)
      branch_name=${branch_name#refs/heads/}
      pattern="${branch_name%+*}*" ;;
    --contains=*) contains="${arg#--contains=}" ;;
    --contains) contains=HEAD ;;
    -B) reset_branch=true ;;
    --force|--detach|--no-track|--track|--track=*) checkout_options+=($arg) ;;
    --) break; ;;
  esac
done

shift $index

if $reset_branch; then
  git checkout ${checkout_options[@]} -B $@
  exit
fi

if (( ( index == ${#checkout_options} + 1 ) && $# > 0 )); then
  if [[ $1 == +* ]]; then
    branch_name=$(git rev-parse --symbolic-full-name HEAD)
    git checkout ${checkout_options[@]} -b ${branch_name#refs/heads/}$1
  else
    git checkout ${checkout_options[@]} -b $@
  fi
  exit
fi

branches=()
if ! $remotes || $all; then
  if [[ -n "$contains" ]]; then
    branches=($(git for-each-ref --contains HEAD --format=%\(refname:short\) refs/heads))
  else
    branches=($(git rev-parse --symbolic --branches=$pattern))
  fi
fi
remote_branches=()
if [[ -n "$contains" ]] && ! $noremote; then
  remote_branches=($(git for-each-ref --contains HEAD --format=%\(refname:short\) refs/remotes))
elif $remotes; then
  remote_branches=($(git rev-parse --symbolic --exclude="*/HEAD" $(print -l -- --exclude="*/"${^branches}) --remotes=$remote_option))

  if ! $all && (( ${#remote_branches} == 0 )); then
    echo "no tracking branches for remote $remote_option"
    exit 1
  fi
fi

branch_format="%(if)%(HEAD)%(then)* %(color:green)%(else)%(if)%(worktreepath)%(then)+ %(color:cyan)%(else)  %(color:normal)%(end)%(end)"

term_menu_options+=(
  --no-preview-border
  --preview-size 0.6
  --preview "$__plugin_dirname/__git-checkoutb-preview {}"
)

remote_options=()
if [[ ${#remote_branches} -gt 0 ]]; then
  remote_options_str="$(printf '%1$s|--remotes %1$s\n' ${^remote_branches})"
  remote_options=("${(f)remote_options_str[@]}")
fi

if [[ ${#branches} == 0 && ${#remote_branches} == 0 ]]; then
  i=1
else
  simple-term-menu $term_menu_options "${branches[@]}" "${remote_options[@]}" && i=0 || i=$?
fi
if (( $i == 0 )) ; then exit; fi

if (( $i > ${#branches})); then
  idx=$(( i - ${#branches}))
  remote_branch=${remote_branches[idx]}
  if [[ -z "$remote_option" ]]; then
    command=(git checkout "${checkout_options[@]}" -b ${remote_branch#*/} $remote_branch)
  else
    command=(git checkout "${checkout_options[@]}" -b $remote_branch $remote_option/$remote_branch)
  fi
else
  branch=${branches[i]}
  command=(git checkout "${checkout_options[@]}" $branch)
fi

echo '>' ${command[@]}
${command[@]}
