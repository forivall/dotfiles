#!/usr/bin/env zsh

set -euo pipefail

__plugin_dirname=${0:a:h:h}

autoload colors && colors

git() {
  if [[ $1 != rev-parse && $1 != ls-remote && ! ( $1 == branch && $2 == --show-current ) ]]; then
    echo '>' git $@
    echo -n "Continue? (y/N) "
    read -k 1 yn
    echo
    [[ $yn == y ]] && command git $@
  else
    command git $@
  fi
}

branch_exists=false
if [[ $# -gt 0 ]]; then
  branch_name=$(git rev-parse --symbolic --revs-only --verify $@ | tail -n1) && branch_exists=true ||
    branch_name=$1
else
  branch_name=$(git branch --show-current) && branch_exists=true
  git switch --detach HEAD
fi
has_remote=false
if remote_rev=$(git rev-parse --symbolic-full-name ${branch_name}@{u}) ||
   remote_rev=$(git rev-parse --symbolic-full-name origin/$branch_name);
then
  has_remote=true
  remote_rev=${remote_rev#refs/remotes/}
  remote_name=${remote_rev%%/*}
  remote_branch=${remote_rev#*/}
fi
if $branch_exists; then
  git branch --delete $(git rev-parse --no-revs $@) $branch_name ||
    git branch --delete $(git rev-parse --no-revs $@) $branch_name --force
fi
if $has_remote; then
  if git ls-remote --exit-code $remote_name $remote_branch > /dev/null; then
    git push $remote_name :$remote_branch
  else
    git branch -d -r $remote_name/$remote_branch
  fi
fi
