#!/usr/bin/env zsh

set -euo pipefail

__plugin_dirname=${0:a:h:h}

autoload colors && colors

git() {
  if [[ $1 != rev-parse && ! ( $1 == branch && $2 == --show-current ) ]]; then
    echo '>' git $@
    echo -n "Continue? (y/N) "
    read -k 1 yn
    echo
    [[ $yn == y ]] && command git $@
  else
    command git $@
  fi
}

branch_name=$(git rev-parse --symbolic --revs-only $@ | tail -n1)
if [[ -z "$branch_name" ]] ; then
  branch_name=$(git branch --show-current)
  git switch --detach HEAD
fi
has_remote=false
if remote_rev=$(git rev-parse --symbolic-full-name ${branch_name}@{u}); then
  has_remote=true
  remote_rev=${remote_rev#refs/remotes/}
  remote_name=${remote_rev%%/*}
  remote_branch=${remote_rev#*/}
fi
git branch --delete $(git rev-parse --no-revs $@) $branch_name ||
  git branch --delete $(git rev-parse --no-revs $@) $branch_name --force
if $has_remote; then
  git push $remote_name :$remote_branch
fi
