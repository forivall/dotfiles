#!/usr/bin/env zsh

[[ $1 == --insert ]] && INSERT=true && shift

LINE_NUM=$1
shift

if [[ $1 == HEAD ]]; then
  followfiles=()
else
  followfiles=($(git log --name-only --relative --format= --follow HEAD ^"$@"| huniq))
fi
# displayargs=(${(f)$(printf "%s\n" "$@" "${followfiles[@]}" | huniq)})
# echo git diff "${displayargs[@]}"
git diff -U1 "$@" "${followfiles[@]}" | while IFS= read line; do
  if [[ $line != @@* ]]; then
    if ${PRINTING:-false} && [[ $line != '+'* ]]; then
      if ${INSERT:-false}; then
        [[ $line == -* ]] && printf '%s\n' "${line:1}"
      else
        printf '%s\n' "${line}";
      fi
    fi
    continue
  fi
  if ${PRINTING:-false}; then break; fi
  added=${line#*+}
  added=${added% @@*}
  start=${added%,*}
  length=${added#*,}
  if (( LINE_NUM >= start && LINE_NUM < start + ( length > 0 ? length : 1 ) )); then
    PRINTING=true
  fi
done
