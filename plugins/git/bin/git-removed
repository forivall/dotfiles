#!/usr/bin/env zsh

LINE_NUM=$1
shift

followfiles=($(git log --name-only --relative --format= --follow HEAD ^"$@"| huniq))
# displayargs=(${(f)$(printf "%s\n" "$@" "${followfiles[@]}" | huniq)})
# echo git diff "${displayargs[@]}"
git diff -C1 "$@" "${followfiles[@]}" | while read line; do
  if [[ $line != @@* ]]; then
    if ${PRINTING:-false} && [[ $line == -* ]]; then
      echo ${line:1};
    fi
    continue
  fi
  if ${PRINTING:-false}; then break; fi
  added=${line#*+}
  added=${added% @@*}
  start=${added%,*}
  length=${added#*,}
  if (( LINE_NUM >= start && LINE_NUM < start + ( length > 0 ? length : 1 ) )); then
    PRINTING=true
  fi
done
