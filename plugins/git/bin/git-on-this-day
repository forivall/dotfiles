#!/usr/bin/env zsh

function git-on-this-day {
  local author
  author='--author=emily'
  if [[ $1 == '--all' ]] ; then author= ; shift ; fi
  if [[ $1 == --author=* ]] ; then author=$1 ; shift ; fi
  local since_; since_="$1"; shift;
  if [[ $1 == --author=* ]] ; then author=$1 ; shift ; fi
  local until_="$1";
  if (( $# > 0 )); then
    shift;
  else
    if [[ ! -d $__zsh_forivall_git_plugin_location/venv ]]; then
      python3 -m venv $__zsh_forivall_git_plugin_location/venv &&
      $__zsh_forivall_git_plugin_location/venv/bin/pip3 install approxidate
    fi
    local sinceParsed
    sinceParsed=$($__zsh_forivall_git_plugin_location/venv/bin/python3 -c "import sys; import approxidate; print(int(approxidate.approx(sys.argv[1])))" "$since_")
    # local sinceParsed=$($__zsh_forivall_git_plugin_location/parse_date/parse_date $since_)
    until_="$(( $sinceParsed + 24 * 60 * 60 ))"
  fi
  local dirname
  local cmd
  cmd=(git --no-pager l3 --color=always --no-graph --all --since "$since_" --until "$until_" $author "$@")
  echo ${(q-)cmd}
  for d in */.git ; do
    dirname="${d%.git}"
    l="$(cd "$dirname"; $cmd)"
    if (( $? > 0 )) || (( $(echo -n "$l"|wc -l) > 0 )) ; then
      echo;
      echo "${d%/.git}";
      echo "$l"
    fi
  done
}

if [[ $ZSH_EVAL_CONTEXT == toplevel ]]; then
  git-on-this-day $@
fi
