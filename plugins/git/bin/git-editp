#!/usr/bin/env zsh

set -eo pipefail

__plugin_dirname=${0:a:h:h}

if (( $# <= 0 )) || ! [[ $1 = diff || $1 = diffc || $1 = grep || $1 = rg || $1 = show ]]; then
  gitcommand=show
else
  gitcommand=$1
  shift
fi

if [[ $1 = --editor=* ]]; then
  GIT_EDITOR=${1#--editor=}
  shift
elif [[ $TERM_PROGRAM = vscode ]]; then
  GIT_EDITOR=code
else
  GIT_EDITOR=$(git config --get core.guieditor || git config --get core.editor)
fi

allow_multi() {
  [[ $GIT_EDITOR = hx || $GIT_EDITOR = helix ]]
}

run_editor() {
  if [[ $GIT_EDITOR = code ]]; then
    if [[ $TERM_PROGRAM = vscode ]]; then
      open "vscode://file/$PWD/$1$2"
    else
      echo code --goto "$1$2"
      code --goto "$1$2"
    fi
  elif [[ $GIT_EDITOR = hx || $GIT_EDITOR = helix ]]; then
    local arg="$1$2"
    shift 2
    echo $GIT_EDITOR "$arg" "$@"
    $GIT_EDITOR "$arg" "$@"
  else
    echo $GIT_EDITOR "$1"
    $GIT_EDITOR "$1"
  fi
}

local configArgs=()
local flags=()
local items=()

local cdup=$(git rev-parse --show-cdup)

get_first_added_line() {
  set -o extendedglob
  local head
  local added
  while read line; do
    if [[ $line == @@*@@* ]]; then
      head=${line#@@ #-<1->(|,<0->) ##+}
      added=${head%% #@@*}
      if [[ $added != *,0 ]]; then
        echo ${added%,<1->}
        return
      fi
    fi
  done
  echo 1
}


case "$gitcommand" in
  diffc)
    flags+=(--cached); ;&
  diff)
    local revs=(${(f)$(git rev-parse --revs-only "$@")})
    if (( ${#revs} == 0 )); then
      revs+=(HEAD)
    fi

    __git-editp-hasfiles() {
      ! git diff-index --quiet "${flags[@]}" $revs
    }
    __git-editp-getitems_vars() {
      local OIFS=$IFS
      IFS=$'\n'
      items=(
        $(git diff "${flags[@]}" --name-only "$@")
      )
      IFS="$OIFS"
      TERM_PICKER_PREVIEW_COMMAND="$__plugin_dirname/__git-addp-preview $cdup{} ${#items} ${flags[@]} $revs"
    }
    __git-editp-dointeractive() {
      # TODO: read editor option from git config
      echo git diff $revs $1
      local loc="$(git diff -U0 $revs $1 | get_first_added_line)"
      if [[ -n $loc ]]; then loc=":$loc"; fi
      run_editor $1 $loc
    }
  ;;
  grep)
    args=()
    for arg in "$@"; do
      if [[ $arg == -- ]]; then break; fi
      args+=($arg)
    done
    __git-editp-hasfiles() {
      local OIFS=$IFS
      IFS=$'\n'
      items=(
        $(git -c color.grep=never grep --name-only $@)
      )
      IFS="$OIFS"
      (( ${#items} > 0 ))
    }
    __git-editp-getitems_vars() {
      usecdup=false
      TERM_PICKER_PREVIEW_COMMAND="git -c color.grep=always grep -h ${(q+@)@} -- {}"
    }
    __git-editp-dointeractive() {
      # TODO: read editor option from git config
      local loc=""
      set -o extendedglob; local result="$(git grep -m 1 -h -n --column $args -- $1)";
      if [[ $result = (#b)(<0->:<0->)* ]]; then
        loc=:${result[$mbegin[1],$mend[1]]};
      fi
      run_editor "$1" "$loc"
    }
  ;;
  rg)
    args=()
    for arg in "$@"; do
      if [[ $arg == -- ]]; then break; fi
      args+=($arg)
    done
    __git-editp-hasfiles() {
      local OIFS=$IFS
      IFS=$'\n'
      items=(
        $(rg --files-with-matches $@)
      )
      IFS="$OIFS"
      (( ${#items} > 0 ))
    }
    __git-editp-getitems_vars() {
      usecdup=false

      TERM_PICKER_PREVIEW_COMMAND="rg --color=always --no-filename --line-number ${(q+@)args} -- {}"
    }
    __git-editp-dointeractive() {
      # TODO: read editor option from git config
      local loc=""
      set -o extendedglob; local result="$(rg -m 1 -n --column $args -- $1)";
      if [[ $result = (#b)(<0->:<0->)* ]]; then
        loc=:${result[$mbegin[1],$mend[1]]};
      fi
      run_editor "$1" "$loc"
    }
  ;;
  show)
    __git-editp-hasfiles() {
      SHOW_REV=$(git rev-parse "$@") && export HELIX_GIT_HEAD=$(git rev-parse ${SHOW_REV:-HEAD}^)
    }
    __git-editp-getitems_vars() {
      items=(
        $(git show --format='' --name-only "$@")
      )
      allow_multi && TERM_PICKER_MULTI=true
      TERM_PICKER_PREVIEW_COMMAND="$__plugin_dirname/__git-showp-preview $cdup{} ${#items} $@"
    }
    __git-editp-dointeractive() {
      local arg=$1; shift
      local loc="$(git show -U0 --format='' $revs $arg | get_first_added_line)"
      if [[ -n $loc ]]; then loc=":$loc"; fi
      run_editor "$arg" "$loc" "$@"
    }
  ;;
esac

source "$__plugin_dirname/__git-patch-filepicker" \
  __git-editp-{hasfiles,getitems_vars,dointeractive} "$@" &&

echo 'No changes are currently staged'

true
