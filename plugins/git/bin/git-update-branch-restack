#!/usr/bin/env zsh
# code: language=shellscript

set -euo pipefail

if [[ $# -lt 2 || "$@[(I)--help]" -gt 0 || "$@[(I)-h]" -gt 0 ]]; then
  echo 'usage: git update-branch-restack <from_ref> <to_ref> [options]'
  echo 'for example, after a `git revise`, use `git update-branch-restack HEAD@{1} HEAD --reverse`'
  return 1 || exit 1
fi

from_head=$1
shift
to_head=$1
shift


typeset -A worktrees_by_branch
() {
  local -a records=( ${(ps.\n\n.)"$(git worktree list --porcelain)"} )
  local i directory branch
  for i in $records; do
    directory=${${i%%$'\n'*}#worktree }
    if [[ ${"${(f)i}"[2]} != 'HEAD '* || ${"${(f)i}"[3]} != 'branch refs/heads/'* ]]; then
      continue
    fi
    branch=${${"${(f)i}"[3]}#branch refs/heads/}
    if [[ -n "$directory" && -n "$branch" ]]; then
      worktrees_by_branch[$branch]=$directory
    fi
  done
}

git_in_worktree() {
  local dir=$1
  shift
  git --git-dir=$(git rev-parse --resolve-git-dir $dir/.git) --work-tree=$dir $@
}

git_update_ref_and_worktree() {
  local ref=$1
  local new_rev=$2
  local dir=$3
  if [[ -n "$dir" ]]; then
    echo "Updating worktree $dir to $new_rev"
    git_in_worktree $dir switch --detach $new_rev
    git update-ref refs/$ref $new_rev
    git_in_worktree $dir switch ${ref#heads/}
  else
    git update-ref refs/$ref $new_rev
    echo $?
  fi
}

prompt_to_update() {
  local branch=${1#heads/}
  local dir=${worktrees_by_branch[$branch]:-}
  if [[ -n "$dir" ]]; then
    echo "NOTE: This branch is currently checked out by worktree $dir"
  fi
  echo -n "Update $1 from $2 to $3? (y/N/p) "
  read -k 1 yn
  echo
  if [[ $yn == y ]]; then git_update_ref_and_worktree $1 $3 "$dir"; fi
  if [[ $yn == p ]]; then git last $2 && git last $3 && prompt_to_update $@; fi
}

exclude=$(git merge-base $from_head $to_head)

for rev in $(git rev-list $from_head ^$exclude $@); do
  ref=$(git describe --exact-match --exclude 'branchless/*' --exclude 'remotes/*' --all $rev 2>/dev/null) || continue
  rev_list_output=(${(f)"$(git rev-list -n1 --pretty=%s $rev)"})
  if new_rev=$(git rev-list -n1 --fixed-strings --grep ${rev_list_output[2]} $to_head ^$exclude $@) && [[ -n "$new_rev" ]]; then
    if [[ $new_rev == $rev ]]; then
      echo "Nothing to do for $ref"
      continue;
    fi
    prompt_to_update $ref $rev $new_rev
  else
    echo "no match for $ref in commit range"
    echo git rev-list -n1 --fixed-strings --grep ${(qq)rev_list_output[2]} $@
  fi
done
