#!/usr/bin/env zsh
# shellcheck disable=SC2168,SC2296,SC2299,SC2300

__plugin_dirname=${0:a:h:h}

args=()
pretty=()
fileargs=()
haspretty=false
hasdashdash=false
dashdash=''
allfiles=false
reflog=false
stash=false
showdiff=true
forcediff=false
namestatus=false
follow=false
maxcount=100

dry=false
navigate=${$(git config delta.navigate):-false}

while (( $# > 0 )); do
if $hasdashdash; then
  args+=("$1")
  fileargs+=("$1")
  shift
  continue
fi
case "$1" in
  -h|--help)
    git log -h | sd 'usage: git log' 'usage: git logp' | sd '\[<revision-range>\]' '[stash|<revision-range>]' | rg -v 'or: git show'
    echo '    --all-files           filter commits on files, but show all files'
    echo
    echo 'in the less pager, use j / k to navigate history backward / forward'
    exit
  ;;
  stash) stash=true; args+=(stash); pretty+=(--pretty=medium) ;&
  --walk-reflogs|-g) reflog=true; shift; continue; ;;
  --patch|-p) forcediff=true; ;&
  --no-patch|--name-only|--raw|--cumulative|--dirstat|--dirstat-by-file|--dirstat-by-file=*|--stat|--numstat|--shortstat|--summary|--compact-summary)
      showdiff=false; pretty+=("$1"); shift; continue; ;;
  --name-status) showdiff=false; namestatus=true; shift; continue; ;;
  --with-name-status) namestatus=true; shift; continue; ;;
  --ignore-cr-at-eol|--ignore-space-at-eol|-b|--ignore-space-change|-w|--ignore-all-space|--ignore-blank-lines|--show-signature|--find-copies|--find-renames|--find-copies-harder|-C*|-M*|--diff-filter=*|--find-copies=*|--find-renames=*|--color-moved|--color-moved=*)
      pretty+=($1); shift; continue;
    ;;
  --diff-filter)
      pretty+=($1 $2); shift; shift; continue;
    ;;
  --pretty=*|--format=*) haspretty=true; pretty+=($1); shift; continue; ;;
  --pretty|--format) haspretty=true; pretty+=($1 $2); shift; shift; continue; ;;
  --navigate) navigate=true; shift; continue; ;;
  --no-navigate) navigate=false; shift; continue; ;;
  --all-files) allfiles=true; shift; continue; ;;
  --dry) dry=true; shift; continue; ;;
  --) hasdashdash=true; args+=("$1"); fileargs=(); shift; continue; ;;
  --reverse|-S*) args+=("$1"); shift; continue; ;;
  --grep|--author) args+=("$1" "$2"); shift; shift; continue; ;;
  --max-count) maxcount="$2"; shift; shift; continue; ;;
  --max-count=*) maxcount="${1#--max-count=}"; shift; continue; ;;
  --no-max-count) maxcount=0; shift; continue; ;;
  --follow) follow=true ;&
  *)
    args+=("$1")
    fileargs+=("$1")
    shift
    continue
  ;;
esac
break;
done

if (( $# > 0 )); then
  echo 'warn: unprocessed arguments' "${(qq)@}"
fi

maxcountargs=()
if (( maxcount > 0 )); then
  maxcountargs=("--max-count=$maxcount")
fi

if $reflog; then
  echo '>' git reflog --pretty=format:%gd "${maxcountargs[@]}" "${args[@]}"
  refspecs="$(git reflog --pretty=format:%gd "${maxcountargs[@]}" "${args[@]}")"
else
  echo '>' git log --pretty=%h "${maxcountargs[@]}" "${args[@]}"
  refspecs="$(git log --pretty=%h "${maxcountargs[@]}" "${args[@]}")"
fi

if $hasdashdash; then
  dashdash="$fileargs "
elif $follow; then
  local followfiles=($(git log --name-only --relative --format= --follow "${args[@]}"| huniq))
  dashdash="$followfiles "
elif ! $allfiles; then
  dashdash="$(git rev-parse --sq --no-flags --no-revs $fileargs) "
fi

deltaOpts=(--tabs 2)
if (( ${+commands[dark-mode]} )) && [[ $(dark-mode status) == off ]]; then
  deltaOpts+=(--light --syntax-theme ${DELTA_LIGHT_THEME:-GitHub})
fi

if $namestatus && ! $haspretty; then
  pretty+=(--pretty=medium)
fi

local lessopen_command
if $reflog; then
  local reflog_command="git reflog show --color -n1 ${(q+@)pretty[@]} \$1;"
  if $stash; then
    if $showdiff || $forcediff; then
      if $hasdashdash && ! $allfiles; then
        # reflog_command+="git stash show --no-patch --color --include-untracked ${(q+@)pretty[@]} \$1 --"
        # reflog_command+="git diff --color --pretty= \$1^ \$1 -- $dashdash | command delta "${deltaOpts[@]}""
        reflog_command+="echo; git diff --color ${(q+@)pretty[@]} --pretty= \$1^ \$1 -- $dashdash | command delta "${deltaOpts[@]}""
      elif $allfiles; then
        reflog_command+="git stash show --patch --color --include-untracked ${(q+@)pretty[@]} \$1 -- | command delta "${deltaOpts[@]}""
      else
        reflog_command+="git stash show --patch --color --include-untracked ${(q+@)pretty[@]} \$1 -- $dashdash | command delta "${deltaOpts[@]}""
      fi
    elif $namestatus; then
      reflog_command+="echo; git diff-file-status --color ${(q+@)pretty[@]} \$1^ \$1 -- $dashdash"
      reflog_command+="; git last --color ${(q+@)pretty[@]} --pretty= \$1^3 -- $dashdash"
    else
    echo ${#dashdash}
      reflog_command+="git stash show --color --include-untracked ${(q+@)pretty[@]} \$1 -- $dashdash | command delta "${deltaOpts[@]}""
    fi
  else
    if $showdiff || $forcediff; then
      reflog_command+="git show --color --pretty= \$1 -- $dashdash | command delta "${deltaOpts[@]}""
    elif $namestatus; then
      reflog_command+="echo; git last --color ${(q+@)pretty[@]} --pretty= \$1 -- $dashdash"
    else
      reflog_command+="echo; git show --color ${(q+@)pretty[@]} --pretty= \$1 -- $dashdash"
    fi
  fi
  lessopen_command="() { $reflog_command } %s"
elif $namestatus; then
  if $showdiff || $forcediff; then
    lessopen_command="() { git last --color ${(q+@)pretty[@]} \$1 -- $dashdash; git show --color ${(q+@)pretty[@]} --pretty= \$1 -- $dashdash| command delta "${deltaOpts[@]}" } %s"
  else
    lessopen_command="git last --color ${(q+@)pretty[@]} %s -- $dashdash"
  fi
else
  lessopen_command="git show --color ${(q+@)pretty[@]} %s -- $dashdash| command delta "${deltaOpts[@]}""
fi

if $dry; then
  for c in "${(f)refspecs[@]}"; do
    echo "${lessopen_command/\%s/$c}"
  done
else
  if (( ! "${(f)#refspecs[@]}" )); then
    echo "No commits found."
    exit
  fi
  export COLUMNS
  if $navigate; then
    # replicate delta's navigate feture
    # https://github.com/dandavison/delta/blob/0.14.0/src/utils/bat/output.rs#L162
    # https://github.com/dandavison/delta/blob/0.14.0/src/features/navigate.rs#L62
    # but default delta config.
    if [[ ! -v LESSHISTFILE ]]; then
      LESSHISTFILE=~/.lesshst
      if [[ ! -e $LESSHISTFILE ]]; then
        unset LESSHISTFILE
      fi
    fi
    DELTA_HIST_FILE=$(mktemp)
    if [[ -v LESSHISTFILE && $LESSHISTFILE != "-" && $LESSHISTFILE != "/dev/null" ]]; then
      cat < $LESSHISTFILE > "$DELTA_HIST_FILE"
    else
      echo ".less-history-file:" > "$DELTA_HIST_FILE"
    fi
    echo ".search" >> "$DELTA_HIST_FILE"
    printf '"^(commit|❖%s%s%s%s%s)\n' "|Δ" "|added:" "|removed:" "|renamed:" "|•" >> "$DELTA_HIST_FILE"
    LESSHISTFILE=$DELTA_HIST_FILE
    export LESSHISTFILE
  fi
  LESSOPEN="| zsh -c ${(q)lessopen_command}" \
   less -f +X -x2 -R --prompt='?f%f .?n?m(%i of %m) ..?lt%lt-%lb?L/%L. ?x- Next\: %x.:?pB%pB\%..%t' --lesskey-src="${__plugin_dirname}/share/git-logp.lesskey" --file-size "${(f)refspecs[@]}"

  wait
  rm "$DELTA_HIST_FILE"
fi
