#!/usr/bin/env zsh

# set -euo pipefail

__plugin_dirname=${0:a:h:h}

autoload -U colors  && colors

action=pop
if [[ "$1" == drop || "$1" == pop || "$1" == apply || "$1" == push ]]; then
  action="$1"
  shift
fi

if [[ $action == push ]]; then
  eval "$(echo "\
git stashp push [<options>] <args>...

semi-interactive stash. pop by default
--
h,help         show the help
k,keep-index   all changes already added to the index are left intact
m,message=     specify stash description
no-keep-index  all changes already added to the index are undone
p,patch        interactively select hunks from diff between HEAD and working tree to stash
" | git rev-parse --parseopt --stuck-long -- "$@" || echo exit $?)"
  local opts
  local args
  opts=()
  args=()
  ispatch=false
  keepindex=
  isopts=true
  for arg in $@; do
    case "$arg" in
      --) isopts=false; ;;
      --patch) ispatch=true; opts+=("$arg") ;;
      --keep-index) keepindex=true; opts+=("$arg") ;;
      --no-keep-index) keepindex=false; opts+=("$arg") ;;
      *) if $isopts; then opts+=("$arg"); else args+=("$arg"); fi ;;
    esac
  done
  if
    git diff-files --quiet "${args[@]}" &&
    git ls-files --other --directory --no-empty-directory --exclude-standard "${args[@]}" | gsed q1 > /dev/null
  then
    echo 'Nothing to do'
    exit 1
  fi

  local cdup=$(git rev-parse --show-cdup)
  local OIFS=$IFS
  IFS=$'\n'
  local items=(
    $(git diff --name-only "${args[@]}")
    $(git ls-files --full-name --other --directory --no-empty-directory --exclude-standard "${args[@]}")
  )
  IFS="$OIFS"
  if ! menuoutput="$(
    simple-term-menu -m \
      --no-preview-border --preview "$__plugin_dirname/__git-addp-preview $cdup{} ${#items}" \
      "${items[@]}"
  )"; then
    set -euo pipefail

    selections=()
    additions=()
    for i in ${(s/,/)menuoutput}; do
      item="${items[i]}"
      if ! git ls-files --error-unmatch "$cdup$item" 2>/dev/null >/dev/null; then
        additions+=($item)
      fi
      selections+=($item)
    done
    tmpcommit=
    if [[ -z "$keepindex" ]] && ! git diff-index --quiet --cached HEAD -- $cdup${^selections}; then
      git commit -m tmp
      tmpcommit=$(git rev-parse HEAD)
    fi
    if (( ${#additions} > 0 )) && $ispatch; then
      echo '>' git add $cdup${(q)^additions}
      git add $cdup${^additions}
    fi
    if $ispatch; then
      echo '>' git stash push "${(qq)opts[@]}" $cdup${(q)^selections}
      git stash push "${opts[@]}" $cdup${^selections}
    else
      echo '>' git stash push --include-untracked "${(qq)opts[@]}" $cdup${(q)^selections}
      git stash push --include-untracked "${opts[@]}" $cdup${^selections}
    fi
    if [[ -n "$tmpcommit" ]]; then
      git reset --soft "$tmpcommit^"
    fi
  fi
  exit
fi

OPTS_SPEC="\
git stashp [apply|pop|drop|push] [<options>] <args>...

semi-interactive stash. pop by default
--
h,help      show the help (unless push)
n,count=    number of stashes to show
index       try to reinstate the changes added to the index as well
d,date=     use date format [default=short-local]
relative    use relative date format
human       use human-local date format
"
eval "$(echo "$OPTS_SPEC" | git rev-parse --parseopt --stuck-long -- "$@" || echo exit $?)"

NUM=10
date=short-local
args=()

for arg in $@; do
  case "$arg" in
    --count=*) NUM="${arg#--count=}" ;;
    --index) args+=(--index) ;;
    --date=*) date="${arg#--date=}" ;;
    --human) date=human-local ;;
    --relative) date=relative ;;
    --) break; ;;
  esac
done

entries=()

_i=0
for i in {0..99} ; do
  stashname=$(git rev-parse --symbolic stash@{$i} 2>/dev/null) || break
  if [[ -z "$stashname" ]] ; then continue; fi
  message=$(git --no-pager reflog show ${stashname} --date=${date} -n1 --format='%s @ %cd')
  entries+=("$stashname $message|$stashname")
  _i=$(( $_i + 1 ))
  if (( $_i >= $NUM )) ; then break; fi
done

term_menu_options=(
  --no-preview-border
  --preview-size 0.6
  --preview "$__plugin_dirname/__git-stashp-preview {}"
)

simple-term-menu $term_menu_options "${entries[@]}" && i=0 || i=$?
if (( $i == 0 )) ; then exit; fi

entry=${entries[i]#*|}
echo '>' git stash $action $args $entry
git stash $action $args $entry
