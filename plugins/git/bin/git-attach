#!/usr/bin/env zsh

set -eo pipefail

__plugin_dirname=${0:a:h:h}

ref=$(git describe --exact-match --all)
ref=${ref#heads/}
ref=${ref#remotes/*/}
echo '>' git checkout ${ref}
git checkout ${ref}

