#!/usr/bin/env zsh

set -eo pipefail

__plugin_dirname=${0:a:h:h}

excluded=($(git config --get-all log.excludeDecoration))
ref=$(git describe --exact-match --all --exclude=${^excluded})
ref=${ref#heads/}
ref=${ref#remotes/*/}
echo '>' git checkout ${ref}
git checkout ${ref}

# TODO: fall back to `git for-each-ref --contains HEAD` and attach if it only contains one branch or one remote
