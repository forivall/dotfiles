#!/usr/bin/env zsh

set -euo pipefail

__filename=${0:A}
__dirname=${0:h}

autoload colors && colors

prompt_and_delete() {
  local branch_name="$1"
  local has_remote=false
  local remote_rev remote_name remote_branch
  if remote_rev=$(git rev-parse --symbolic-full-name ${branch_name}@{u}) ||
     remote_rev=$(git rev-parse --symbolic-full-name origin/$branch_name);
  then
    has_remote=true
    remote_rev=${remote_rev#refs/remotes/}
    remote_name=${remote_rev%%/*}
    remote_branch=${remote_rev#*/}
  fi
  if $has_remote; then
    echo -n "Delete remote for branch $branch_name? (y/N) "
    read -k 1 yn
    echo
    if [[ $yn == y ]] ; then
      if git ls-remote --exit-code $remote_name $remote_branch > /dev/null; then
        git push $remote_name :$remote_branch
      else
        git branch -d -r $remote_name/$remote_branch
      fi
    fi
  fi
  echo -n "Delete merged branch $branch_name? (y/N) "
  read -k 1 yn
  echo
  if [[ $yn == y ]] ; then
    git branch -d $branch_name
  else
    return 0
  fi
}

for branch in $(git rev-parse --symbolic --branches); do
  if [[ $branch == *+* ]]; then
    basebranch=${branch%+*}
    if git merge-base --is-ancestor $branch $basebranch; then
      prompt_and_delete $branch
      continue
    fi
  fi
  if [[ $branch == feature/* ]]; then
    upstream=${1:-origin/dev}
    if git merge-base --is-ancestor $branch $upstream; then
      prompt_and_delete $branch
    else
      echo "${fg[grey]}$branch is not merged into $upstream$reset_color"
    fi
  elif [[ $branch == hotfix/* ]]; then
    upstream=${1:-origin/master}
    if git merge-base --is-ancestor $branch $upstream; then
      prompt_and_delete $branch
    else
      echo "${fg[grey]}$branch is not merged into $upstream$reset_color"
    fi
  elif [[ $# -gt 0 ]]; then
    upstream=$1

    if git merge-base --is-ancestor $branch $upstream; then
      prompt_and_delete $branch
    fi
  fi
done
