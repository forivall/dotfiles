#!/usr/bin/env zsh

set -euo pipefail

autoload colors && colors

wasrun=false
run() {
  wasrun=true

  printf '\e]133;A\a'
  printf '\e[2m%s\e[22m %s ' 'prep' '>'
  printf '\e]133;B\a'
  echo $@
  printf '\e]133;C\a'
  $@
}
log() {
  if (( $# > 0 )) && [[ $1 != '-' ]]; then
    printf '\e[2m%s '"${fg[yellow]}"'%s %s'"${reset_color}"'\e[22m\n' 'prep' '#' "$@"
  else
    while read line; do
      printf '\e[2m%s '"${fg[yellow]}"'%s %s'"${reset_color}"'\e[22m\n' 'prep' '#' "$line"
    done
  fi
}

BUILD=false
if (( $# > 0 )) && [[ $1 == build || $1 == b ]]; then
  BUILD=true
fi
: ${PREP_SAFE:=false}
if (( $# > 0 )) && [[ $1 == --safe ]]; then
  PREP_SAFE=true
fi

if [[ -f package.json ]] &&
  jsPackageManager=$(jq -e -r '.packageManager // empty' package.json)
then
  run corepack prepare
  if [[ $jsPackageManager == pnpm@* ]] &&
    jq -e -r '.name == "definitely-typed"' package.json > /dev/null;
  then
    run pnpm install --filter .
  else
    run ${jsPackageManager%@*} install
  fi
elif [[ -f pnpm-lock.yaml ]] || [[ -f pnpm-workspace.yaml ]]; then
  COREPACK_ENABLE_AUTO_PIN=0 run pnpm install --frozen-lockfile --filter .
elif [[ -f yarn.lock ]]; then
  COREPACK_ENABLE_AUTO_PIN=0 run yarn --frozen-lockfile
elif [[ -f bun.lockb ]]; then
  run bun install
elif [[ -f package-lock.json ]]; then
  if $PREP_SAFE; then
    run npm install --ignore-scripts
    jq -r '. as $pkg|["postinstall","preinstall","install"]|map(if $pkg.scripts[.] then .+": "+$pkg.scripts[.] else empty end)|if length then ("Skipped the following install script(s):",.[]) else empty end' package.json | log
    if jq -e '.scripts.prepare' package.json > /dev/null; then
      run npm run prepare
    fi
    log 'run `npm install --no-ignore-scripts` directly to run dependency install scripts'
    log 'check install scripts with `npx can-i-ignore-scripts@0.1.9`'
  else
    run npm install
  fi
elif [[ -f package.json ]]; then
  local q p=$PWD
  while
    q=$p; p=${p:h};
    [[ $p != '/' && $p != $q ]] &&
    ! ( [[ -f $p/package.json ]] && jq --exit-status .workspaces $p/package.json > /dev/null ) &&
    ! [[ -f $p/pnpm-workspace.yaml ]]
  do :; done
  if [[ $p == '/' ]]; then
    echo '# no lockfile found or packageManager defined, using npm'
    run npm install
  else
    source ${0:A:h:h:h}/jump/loadnameddirs.zsh
    echo '# `package.json` found in an npm workspace. Run `npm i` or `prep` in `'$(cd $p; print -P '%~')'` instead'
  fi
fi

if [[ -f WORKSPACE ]]; then
  local bazel_cmd=bazel
  if [[ -x node_modules/.bin/bazelisk ]]; then
    bazel_cmd=node_modules/.bin/bazelisk
  fi
  if run $bazel_cmd info workspace ; then
    if $BUILD; then
      run $bazel_cmd build //...
    elif ${PREP_BAZEL_FETCH:-false}; then
      run $bazel_cmd fetch //...
    fi
  fi
fi

if [[ -f pdm.lock ]]; then
  run pdm install
  # generate a .direnv instead (if none exists)
  echo "# run \`eval $\(pdm venv activate)\` for virtualenv"
elif [[ -f poetry.lock ]]; then
  run poetry install
elif [[ -f pyproject.toml ]]; then
  if tomlq -e '."build-system"."build-backend" == "hatchling.build"' pyproject.toml >/dev/null; then
    run hatch status
  else
    echo unknown pyproject
    exit 1
  fi
fi

if [[ -f Cargo.toml ]]; then
  if $BUILD; then
    run cargo build
  else
    run cargo fetch
  fi
fi

if [[ -f Podfile ]]; then
  run pod install
fi

if [[ -f conanfile.txt ]] || [[ -f conanfile.py ]]; then
  run conan install
elif [[ -f vcpkg.json ]]; then
  run vcpkg install
fi

if [[ -f go.mod ]]; then
  if $BUILD; then
    run go build
  else
    run go mod download -x
  fi
fi

if [[ -f pubspec.yaml ]]; then
  run dart pub get
fi

if [[ -f CMakeLists.txt ]]; then
  run cmake .
fi

if [[ -f meson.build ]]; then
  run meson setup build/
elif [[ -x ./configure ]]; then
  run ./configure
fi
if [[ -f Makefile ]] && $BUILD; then
  make
fi

if [[ -f pom.xml ]]; then
  run mvn --help
fi

if [[ -f composer.json || -f composer.lock ]]; then
  run php composer.phar install
elif [[ -f phpkg.config.json ]]; then
  run phpkg install
fi

if [[ -f dune-project ]]; then
  run opam install . --deps-only --with-test --with-doc
fi

if [[ -f *.rockspec ]]; then
  run luarocks install --only-deps *.rockspec
fi

if ! $wasrun; then
  echo '# no supported manifest files found'
fi
