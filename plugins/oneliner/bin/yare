#!/usr/bin/env zsh

set -euo pipefail

wasrun=false
run() {
  wasrun=true

  printf '\e]133;A\a'
  printf '\e[2m%s\e[22m %s ' 'yare' '>'
  printf '\e]133;B\a'
  echo $@
  printf '\e]133;C\a'
  $@
}

if [[ -f package.json ]] &&
  jsPackageManager=$(jq -e -r '.packageManager // empty' package.json)
then
  run ${jsPackageManager%@*} run  "$@"
elif [[ -f yarn.lock ]]; then
  run yarn run "$@"
elif [[ -f pnpm-lock.yaml ]]; then
  run pnpm run "$@"
elif [[ -f bun.lockb ]]; then
  run bun run "$@"
elif [[ -f package-lock.json ]]; then
  run npm run "$@"
elif [[ -f package.json ]]; then
  echo '# no lockfile found or packageManager defined, using npm'
  run npm run "$@"
elif [[ -f Makefile ]] || [[ -f makefile ]]; then
  run make "$@"
fi

if $wasrun; then exit; fi

echo "no task runner configuration was found"
exit 1
