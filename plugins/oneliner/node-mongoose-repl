  db = (await DbTestHarness.createTenantDb('repl')).db;
  tenantDb = require('@ttc/ttc-tenant-config-helper').getTenantConfigDb(db);
  console.log('Connected to', mongod.getUri());
  ttc = require('@ttc/tenthousandcoffees-schema');
  console.log('Loaded variables: mongoose, mongod, db, tenantDb, ttc');
  process.stdout.write('> ');
});
}
