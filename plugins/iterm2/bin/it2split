#!/usr/bin/env python3.12

import asyncio
import iterm2
import shlex
import sys
import os
from optparse import OptionParser

parser = OptionParser()
parser.disable_interspersed_args()
parser.add_option("--restart", action="store_true", default=False)
parser.add_option("--no-focus", action="store_false", default=True, dest="focus")
parser.add_option("--pause", action="store_true", default=False, dest="pause")
parser.add_option("--cwd", action="store")

options, argv = parser.parse_args(sys.argv[1:])
command_arg = argv[0] if len(argv) else None
origin_cwd = options.cwd or os.getcwd()


async def run_in_split_pane(c: "iterm2.Connection"):
    a: "iterm2.App" = await iterm2.async_get_app(c)
    n = await get_target_session(a)
    cmd_text = " ".join(shlex.quote(r) for r in argv)
    # o = iterm2.LocalWriteOnlyProfile()
    # o.set_command(cmd_text)
    is_new = n is None
    if n is None:
        w: "iterm2.Window" = a.current_terminal_window
        t: "iterm2.Tab" = a.get_tab_by_id(w.selected_tab_id)
        s: "iterm2.Session" = a.get_session_by_id(t.active_session_id)
        n = await s.async_split_pane(vertical=True, before=False)
        if options.cwd:
            await n.async_send_text("cd " + shlex.quote(origin_cwd) + "\n")
        if command_arg is not None:
            await n.async_send_text(cmd_text + ("" if options.pause else "\n"))
        await n.async_set_variable("user.it2split", command_arg)
        await n.async_set_variable("user.it2split_cwd", origin_cwd)
    elif options.restart:
        await n.async_restart()
        restarted = await get_target_session(a)
        if restarted:
            n = restarted
        await n.async_send_text(cmd_text + ("" if options.pause else "\n"))
    else:
        p = await iterm2.async_get_last_prompt(c, n.session_id)
        if p is None:
            await n.async_send_text("q")
        elif p.state == iterm2.PromptState.RUNNING:
            # TODO: see if this works as ctrl+c
            await n.async_send_text("\x03")
            await asyncio.sleep(0.1)
        await n.async_send_text(cmd_text + ("" if options.pause else "\n"))

    if options.focus:
        await n.async_activate()
    elif is_new:
        await s.async_activate()


async def get_target_session(a: "iterm2.App") -> "iterm2.Session | None":
    if command_arg == 'cd':
        return None
    for w in a.terminal_windows:
        for t in w.tabs:
            for s in t.sessions:
                split_command = await s.async_get_variable("user.it2split")
                split_cwd = await s.async_get_variable("user.it2split_cwd")
                if split_command == command_arg and split_cwd == origin_cwd:
                    return s
    return None


iterm2.run_until_complete(run_in_split_pane)
