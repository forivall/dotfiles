#!/usr/bin/env zsh

__dirname=${0:A:h}
configdir=${PWD:A}
while [[ $configdir != / ]]; do
  if [[ -f .vscode/settings.json ]]; then
    break;
  fi
  configdir="${configdir:h}"
done
jsonc_strip_comments=(rg -P -e '("(?:[^"]|\\")*(?<!\\)")' -e '//.*' -e ',\s*(\}|\])' --multiline --passthrough --replace '$1$2')
if [[ -f $configdir/.vscode/settings.json ]] &&
  $jsonc_strip_comments "$configdir/.vscode/settings.json" |
    jq --exit-status '."findrelated.rulesets"' > /dev/null || echo failed to parse "$configdir/.vscode/settings.json" >&2
then
  configdir="$configdir/.vscode"
else
  configdir="${__dirname:h:h:h}/vscode"
fi

RULES=($($jsonc_strip_comments "$configdir/settings.json" |
  jq -r '."findrelated.rulesets"[].rules[]|@base64'))
if [[ ${#RULES} -eq 0 ]]; then
  : # TODO
fi

for rule in "$RULES[@]"; do
  if ${DEBUG:-false}; then
    printf 'RULE: ' >&2
    jq --compact-output -nr --arg input "$rule" '$input|@base64d|fromjson' >&2
  fi
  PATTERN="$(jq -nr --arg input $rule '$input|@base64d|fromjson|.pattern')"
  LOCATORS="$(jq -nr --arg input $rule '$input|@base64d|fromjson|.locators|join("\n")')"
  echo "${(F)@}" | rg $PATTERN -r $LOCATORS | while read candidate; do
    if [[ -f $candidate ]]; then
      echo $candidate
    elif ${DEBUG:-false}; then
      printf '!%s\n' $candidate >&2
    fi
  done
done

