      "command": "smerge mergetool ${fileBasenameNoExtension}_{BASE,LOCAL,REMOTE}_* -o ${fileBasename}",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
