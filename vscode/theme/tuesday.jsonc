	"tokenColors": [
		{
			"scope": "comment, punctuation.definition.comment",
			"settings": {
				"foreground": "#8E908C",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "variable, string constant.other.placeholder",
			"settings": {
				"foreground": "#4D4D4C"
			}
		},
		{
			"scope": "invalid",
			"settings": {
				"foreground": "#C82829",
				"background": "#FFFFFF"
			}
		},
		{
			"scope": "invalid.deprecated",
			"settings": {
				"foreground": "#8959A8",
				"background": "#FFFFFF"
			}
		},
		{
			"scope": "keyword, storage.type, storage.modifier, storage.control",
			"settings": {
				"foreground": "#8959A8"
			}
