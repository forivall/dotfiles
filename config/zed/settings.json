// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "multi_cursor_modifier": "cmd_or_ctrl",
  "file_finder": {
    "file_icons": true
  },
  "tab_size": 2,
  "icon_theme": "Catppuccin Mocha",
  "search": {
    "button": true
  },
  "languages": {
    "Markdown": {
      "formatter": [
        { "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}", "--prose-wrap=always"]
        }}
      ],
      "prettier": {
        "allowed": true,
        "parser": "markdown"
      }
    }
  },
  "minimap": {
    "show": "always"
  },
  "features": {
    "edit_prediction_provider": "zed"
  },
  "edit_predictions": {
    "mode": "subtle",
    "enabled_in_text_threads": false,
    "disabled_globs": ["*.md"]
  },
  "agent": {
    "default_model": {
      "provider": "google",
      "model": "gemini-2.0-flash-lite-preview"
    },
    "version": "2"
  },
  "base_keymap": "Atom",
  "journal": {
    "hour_format": "hour12",
    "path": "/Users/emily.klassen/Library/CloudStorage/GoogleDrive-emily.klassen@tenthousandcoffees.com/My Drive/10KC_notes"
  },
  "project_panel": {
    "dock": "left",
    "indent_size": 10,
    "file_icons": true,
    "entry_spacing": "standard",
    "default_width": 120,
    "auto_fold_dirs": true
  },
  "current_line_highlight": "gutter",
  "ui_font_size": 14.2,
  "unstable.ui_density": "compact",
  "buffer_font_size": 13.3,
  "buffer_font_family": "FantasqueSansM Nerd Font Mono",
  "ui_font_family": "SF Pro Display",
  "format_on_save": "off",
  "remove_trailing_whitespace_on_save": true,
  "buffer_line_height": "standard",
  "terminal": {
    "line_height": "standard",
    "toolbar": {
      "breadcrumbs": true
    },
    "shell": {
      "program": "/opt/homebrew/bin/zsh"
    }
 },
  "message_editor": {
    "auto_replace_emoji_shortcode": true
  },
  "helix_mode": true,
  "vim": {
    "cursor_shape": {"normal": "hollow"},
    "default_mode": "helix_normal",
    "custom_digraphs": {},
    "toggle_relative_line_numbers": true,
    "use_smartcase_find": true,
    "use_system_clipboard": "never"
  },
  "outline_panel": {
    "scrollbar": {
      "show": "auto"
    },
    "dock": "right",
    "default_width": 220,
    "indent_size": 16
  },
  "relative_line_numbers": true,
  "wrap_guides": [80],
  "indent_guides": {
    "coloring": "indent_aware",
    "enabled": true,
    "line_width": 1,
    "active_line_width": 1
  },
  "lsp": {
    "pyright": {
      "settings": {
        "python.analysis": {
          "diagnosticMode": "workspace",
          "typeCheckingMode": "strict",
          "extraPaths": [
            "~/code/10kc/python-worktrees/api-server/python/generate-match-pairings/.venv/lib/python3.9/site-packages"
          ]
        },
        "python.analysis.diagnosticSeverityOverrides": {
          "reportGeneralTypeIssues": "warning",
          "reportOptionalSubscript": "warning"
        },
        "python": {
          "pythonPath": ".venv/bin/python"
        }
      }
    }
  },
  "theme": {
    "mode": "system",
    "dark": "Base16 Tomorrow Night",
    "light": "Base16 standardized-light"
  },
