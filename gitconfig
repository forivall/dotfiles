[user]
	name =
	useConfigOnly = true
	email =
[core]
	#autocrlf = input
	# pager = delta --dark --theme base16
	# pager = less +X -x2 -R
	# pager = most
	pager = moor --no-linenumbers --colors 16 --style igor
	excludesfile = ~/.gitignore
	trustctime = false
	editor = hx
	# trustctime = false
	attributesfile = ~/.gitattributes_global

[diff]
	renames = copies
	tool = vscode
	# colorMoved = default
[difftool]
	prompt = false
[interactive]
	diffFilter = deltaw --color-only
[log]
  excludeDecoration = refs/jj/**
  allExcludes = --exclude=refs/remotes/*/archive/** --exclude=refs/tags/archive/** --exclude=refs/branchless/** --exclude=refs/jj/** --exclude=refs/remotes/origin/gh-pages
[delta]
	navigate = true  # use n and N to move between diff sections
	minus-style = syntax auto
	syntax-theme = base16-tomorrow-night
	features = map-styles-dark
	# hyperlinks = true
[delta "map-styles-dark"]
	map-styles = \
		bold purple => syntax "#330f29", \
		bold blue => syntax "#271344", \
		bold cyan => syntax "#0d3531", \
		bold yellow => syntax "#222f14"
[delta "map-styles-light"]
	map-styles = \
		bold purple => syntax "#feecf7", \
		bold blue => syntax "#e5dff6", \
		bold cyan => syntax "#d8fdf6", \
		bold yellow => syntax "#f4ffe0"
[alias]
	aliases = !git config --get-regexp 'alias.*' | colrm 1 6 | sed 's/[ ]/ = /' | sort
	br = branch
	ci = commit
	cie = commit-edit
	co = checkout
	cop = checkoutp

	st = status -b -s
	stat = status -b -s

	# --pretty=format:"%H%x20%an%x09%ad%x09%s"
	ahead = log --name-status --pretty=onemore --graph HEAD ^origin/HEAD
	ahead-root = !git --no-pager log --oneline HEAD ^origin/HEAD
	ahead2 = log --name-status --abbrev-commit --pretty=oneline --graph --decorate HEAD ^origin/HEAD
	exclude = "!f() { for p in \"$@\" ; do echo \"$GIT_PREFIX$p\" >> $GIT_DIR/info/exclude ; done; }; f"
	delta = -c core.pager=deltaw diff
	deltac = -c core.pager=deltaw diff --cached
	deltas = -c core.pager=deltaw show
	diffc = diff --cached
	diffd = -c core.pager=deltaw diff
	diffd-2way = -c core.pager=deltaw diff-2way
	diffdh = "!(printf \"❖ diff %s\n\" \"$*\" && git diff \"$@\") | deltaw --commit-regex=\"^❖ \" --commit-style=yellow && :"
	difft = -c diff.external=difft diff
	diffc-fnames = -c pager.diff=false diff --cached --name-only --diff-filter
	diff-fnames = -c pager.diff=false diff --name-only --diff-filter
	dd = -c core.pager=deltaw diff
	dp = diffp
	dc = diff --cached

	diffcd = -c core.pager=deltaw diff --cached
	showd = -c core.pager=deltaw show
	stashsd = -c core.pager=deltaw stash show -p
	last = -c pager.show=off show --oneline --name-status --decorate
	last2 = last --name-status --pretty=twomore
	l = log --pretty=oneline --abbrev-commit --decorate --graph
	lc = "!f() { git log --pretty=oneline --abbrev-commit --decorate --graph ${1:-HEAD} $(git branch --format=\"%(objectname:short)\" --all --contains ${1:-HEAD}) ${@:2}; }; f"
	lr = log --pretty=oneline --abbrev-commit --decorate --reverse
	lm = log --pretty=oneline --abbrev-commit --decorate --graph --simplify-by-decoration --tags
	lp = !git log --pretty=oneline --abbrev-commit --decorate --graph HEAD $(git rev-parse --symbolic --glob=\"$(git rev-parse --symbolic-full-name)*\")
	lu = logu --pretty=oneline --abbrev-commit --decorate --graph
	lup = "!git log --pretty=oneline --abbrev-commit --decorate --graph HEAD @{u} $(git rev-parse --symbolic --glob=\"$(git rev-parse --symbolic-full-name @{u})*\")"
	lus = log --pretty=oneline --abbrev-commit --decorate --graph --simplify-by-decoration HEAD @{u}
	li = log --pretty=oneline --abbrev-commit --decorate --graph HEAD @{u}  # <kbd>i</kbd> is much easier to hit than <kbd>u</kbd>
	la = log --pretty=oneline --abbrev-commit --decorate --graph --exclude=refs/stash --exclude=refs/remotes/*/archive/** --exclude=refs/tags/archive/** --exclude=refs/branchless/** --exclude=refs/jj/** --exclude=refs/remotes/origin/gh-pages --all
	las = log --pretty=oneline --abbrev-commit --decorate --graph --exclude=refs/stash --exclude=refs/remotes/*/archive/** --exclude=refs/tags/archive/** --exclude=refs/branchless/** --exclude=refs/jj/** --exclude=refs/remotes/origin/gh-pages --all --simplify-by-decoration
	laa = log --pretty=oneline --abbrev-commit --decorate --graph --all
	lo = log --pretty=oneline --abbrev-commit --decorate --graph --remotes=origin --branches
	l2 = log --pretty=onemore --decorate --graph --no-notes
	l3 = log --pretty=twoline --decorate --graph --date=local
	lg = log --name-status --pretty=oneline --abbrev-commit --decorate --graph
	lga = log --name-status --pretty=oneline --abbrev-commit --decorate --graph --exclude=refs/stash --exclude=refs/remotes/*/archive/** --exclude=refs/tags/archive/** --exclude=refs/branchless/** --exclude=refs/jj/** --exclude=refs/remotes/origin/gh-pages --all
	lgaa = log --name-status --pretty=oneline --abbrev-commit --decorate --graph --all
	lg2 = log --name-status --pretty=onemore --graph --no-notes
	lg3 = log --name-status --pretty=twoline --graph --date=local
	lgp = log -p --pretty=onemore --graph
	logd = -c core.pager='deltaw --commit-regex="^❖ "' log --pretty=concise
	log2 = log --pretty=concise
	logp2 = logp --pretty=concise
	logpa = logp --exclude=refs/stash --exclude=refs/remotes/*/archive/** --exclude=refs/tags/archive/** --exclude=refs/branchless/** --exclude=refs/jj/** --exclude=refs/remotes/origin/gh-pages --all
	logpa2 = logp --exclude=refs/stash --exclude=refs/remotes/*/archive/** --exclude=refs/tags/archive/** --exclude=refs/branchless/** --exclude=refs/jj/** --exclude=refs/remotes/origin/gh-pages --all  --pretty=concise
	show2 = show --pretty=concise
	showd2 = showd --pretty=concise
	ll = log --pretty=oneline --abbrev-commit --decorate --graph --branches=*
	branch-name-ref = !git symbolic-ref HEAD 2> /dev/null || cat $GIT_DIR/rebase-merge/head-name
	branch-name = !git branch-name-ref | sed 's|^refs/heads/||'
	branches = branch --list
	branches-with-upstreams = "!zsh -c 'if (( $# > 0 )); then opt=(\"--branches=\"${^@}); else opt=(--branches); fi; git rev-parse --symbolic ${opt[@]} | while read branch; do echo $branch; up=$(git rev-parse --symbolic $branch@{u} 2>/dev/null) && echo $up; done' -"
	llu = "!git log --pretty=oneline --abbrev-commit --decorate --graph $(git branches-with-upstreams)"
	llus = "!git log --pretty=oneline --abbrev-commit --decorate --graph --simplify-by-decoration  $(git branches-with-upstreams)"
	shlg = log --name-status --pretty=raw --abbrev-commit --decorate --graph
	tracking-status = for-each-ref --format='%(refname:short) <- %(upstream:short)' refs/heads
	ignore-for-now = update-index --assume-unchanged
	nearest-remote-rev = "!f() { git rev-list --boundary ${1:-HEAD} --not --remotes | { ! sed -n 's/^-//p;T;q1'; } || git rev-parse ${1:-HEAD}; }; f"
	update-branch-upstream = "!f() { branch=${1:-$(git symbolic-ref --short HEAD)}; shift; git update-ref \"refs/heads/$branch\" \"$branch@{u}\" $@; }; f"
	push-new-branch = "push -u"
	reset-upstream = reset @{u}
	root = rev-parse --show-toplevel
	tag-column = !git tag "$@" | column
	# useful to force make to rebuild changed files; just `| xargs touch`
	show-files-only = show --pretty="format:" --name-only
	serve = daemon --export-all --base-path=. --verbose
	commit-edit = "!git commit --edit --file \"$(git rev-parse --git-dir)/COMMIT_EDITMSG\""
	env = "!env"
	checkout-pull-detach = "!f() { git checkout \"$@\" && git pull && git detach-head; }; f"
	detach-head = checkout --detach HEAD
	wt = "worktree"
	worktree-dirs = "!git worktree list --porcelain | rg '^worktree ' --replace ''"
	worktree-main = "!git worktree list --porcelain | head -n1 | sd '^worktree ' ''"
	worktree-do= "worktree do"
	worktree-each= "worktree each"
	worktree-ls = worktree list
	worktree-mv = worktree move
	worktree-rm = worktree remove
	worktree-cd = "worktree cd"
	# looks like ripgrep
	grep-pretty = "grep --break --heading"
	rg = "grep --break --heading"

	# legit
	# branches = !legit branches
	# brs = !legit branches
	# graft = !legit graft \"$@\"
	# harvest = !legit harvest \"$@\"
	# publish = !legit publish \"$@\"
	# sprout = !legit sprout \"$@\"
	# switch = !legit switch \"$@\"
	# sync = !legit sync \"$@\"
	# unpublish = !legit unpublish \"$@\"

	exec = "!exec "

	# aliases for custom commands
	sm = subl-modified
	sp = subl-projects
	unstage = reset HEAD --
	amend = commit --amend --no-edit
	reword = revise --no-index --edit HEAD
	reword = "!f() { git branchless wrap revise --no-index --edit ${@:-HEAD}; }; f"
	cob = checkout-branch
	checkout-branch = checkout
	unresolve = checkout --conflict=merge
	config-user = "!git config --local user.name \"$1\" && git config --local user.email \"$2\" && :"
	# for ease of use, add a `git-config-signing` in ~/.local/bin with the key id as default
	config-signing = "!git config --local user.signingkey \"$1\" && git config --local commit.gpgSign true && git config --local tag.gpgSign true && :"

	addu = add -u
	showp = !git-showp
	absorb = !git-absorb
	addg = !git-addg
	addp = !git-addp
	archive-untracked-files = !git-archive-untracked-files
	attach = !git-attach
	bak = !git-bak
	blameall = !git-blameall
	bonsai = !git-bonsai
	branch-archive = !git-branch-archive
	branch-cleanup = !git-branch-cleanup
